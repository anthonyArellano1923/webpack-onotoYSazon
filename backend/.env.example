PORT=4000
NODE_ENV=development

# Ruta del archivo SQLite.
# En producción (Render): /data/onoto.db  (disco persistente montado en /data)
# En desarrollo: dejar vacío para usar backend/onoto.db por defecto
DB_PATH=

# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=reemplaza-esto-con-una-clave-secreta-de-64-bytes

# Duración del token: 2h, 1d, 7d, etc.
JWT_EXPIRES_IN=2h

# Solo permite peticiones desde este origen (cambia en producción)
CORS_ORIGIN=http://localhost:3006

# Cuenta de administrador (se crea automáticamente al iniciar).
# El login es POR TELÉFONO: ADMIN_PHONE es el identificador de la cuenta
# (9 dígitos chilenos, ej. 912345678; el +56 se agrega solo).
# ADMIN_EMAIL es opcional y sirve para migrar un admin creado por versiones viejas.
ADMIN_PHONE=912345678
ADMIN_EMAIL=admin@onotosazon.cl
# Si la contraseña contiene '#', ponla entre comillas: ADMIN_PASSWORD="Mi#Clave123"
ADMIN_PASSWORD=CambiaMeEnProduccion123!
ADMIN_NAME=Admin

# ---- PLAN-11: pedidos por confirmar, límite por teléfono y avisos ----
# Horas que un pedido web reserva stock sin confirmar (1..168). Al vencer, el stock se libera solo.
ORDER_HOLD_HOURS=24
# Horas antes del vencimiento en que llega el aviso "por vencer" (0..ORDER_HOLD_HOURS-1).
ORDER_REMINDER_HOURS_BEFORE=4
# Máximo de hallacas en pedidos web activos por número de celular (1..10000).
MAX_HALLACAS_POR_TELEFONO=20
# Bot de Telegram para avisar al dueño. Vacíos = sin avisos (los pedidos funcionan igual).
# Token: @BotFather → /newbot. Chat ID: https://api.telegram.org/bot<TOKEN>/getUpdates → message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Enlace al sitio que se incluye en los avisos (el panel se abre desde ahí).
PUBLIC_ADMIN_URL=https://www.onotosazon.cl
# Render pone un proxy delante: 1 = confiar en el primer salto para leer la IP real del cliente.
TRUST_PROXY=1
# Zona horaria para los cortes de día de reportes y fechas locales.
TZ=America/Santiago
